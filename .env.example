# Copy this file to .env and paste a new Hugging Face token.
# Never commit .env.
HF_TOKEN=hf_your_new_token

# --- Layer 2 LLM judge (optional) ---
# off | gray (default) | all
LAYER2_MODE=gray
# Path to the GGUF judge model (default: ./Qwen3.5-9B.Q4_K_M.gguf)
# LAYER2_MODEL_PATH=Qwen3.5-9B.Q4_K_M.gguf
# GPU layers to offload (0 = CPU only, -1 = all layers on GPU)
LAYER2_GPU_LAYERS=0
