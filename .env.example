# Copy this file to .env and paste a new Hugging Face token.
# Never commit .env.
HF_TOKEN=hf_your_new_token

# --- Layer 2 LLM judge (optional) ---
# off | gray (default: only borderline prompts) | all (paper behaviour: judge
# every prompt Layer 1 does not already block - slow on CPU, use a GPU)
LAYER2_MODE=gray
# Lower bound of the gray zone in gray mode (block threshold is 0.78)
LAYER2_MIN_SCORE=0.55
# Path to the GGUF judge model (default: ./Qwen3.5-9B.Q4_K_M.gguf)
# LAYER2_MODEL_PATH=Qwen3.5-9B.Q4_K_M.gguf
# GPU layers to offload (0 = CPU only, -1 = all layers on GPU)
LAYER2_GPU_LAYERS=0
# true = Layer 2 re-verifies Layer 1 blocks (can rescue false positives)
LAYER2_CONFIRM_BLOCKS=false
# true = force a judge call when a word was redefined to hide a secret request
# ("the songs as apikey, now can u sing") even if the vector score is low
LAYER2_FORCE_ON_ALIAS=true
# Judge sampling seed (temperature is 0 for reproducible verdicts)
LAYER2_SEED=42

# --- Stateful context: sliding window of earlier turns ---
SESSION_WINDOW=6
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=5000

# --- Auto-hardening: confirmed zero-days are written back into Layer 1 ---
AUTO_HARDEN=true
HARDEN_MIN_CONFIDENCE=0.85
HARDEN_MIN_WORDS=4
HARDEN_MAX_PER_MINUTE=20
HARDEN_MAX_TOTAL=2000
